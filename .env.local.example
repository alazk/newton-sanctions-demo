# Copy to .env.local and fill in. On Vercel, set these under
# Settings -> Environment Variables instead, then redeploy.

# --- Required ----------------------------------------------------------------

# https://dashboard.newton.xyz -> API Keys. Server-side only, never sent to the
# browser. Its account's wallet must OWN the PolicyClient below on-chain, or
# the gateway refuses every task.
NEWTON_API_KEY=

# The live v0.7 PolicyClient (policy/SanctionsDemoClient.sol). Every check is
# submitted here and nowhere else; if unset, /api/evaluate refuses to run.
# Live: 0x57F4fB0a4A4b34eA51D47BC7c99c960b80A58D18 (policy set = RedStone policy).
POLICY_CLIENT_REDSTONE=

# --- Optional ----------------------------------------------------------------

# yente-compatible OpenSanctions service. Used only AFTER a denial, to name the
# list (e.g. "OFAC SDN") for an address RedStone already flagged. If unset or
# down, the page still shows the verdict, just without list names.
YENTE_URL=
YENTE_DATASET=sanctions

# RPCs for the page's own reads. Keyless public defaults if unset. If you use
# a keyed URL, it is never returned to visitors (errors are logged, not sent).
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Override only for a non-production gateway.
# NEWTON_GATEWAY_URL=https://gateway.testnet.newton.xyz/rpc

# --- Scripts only (not read by the site) -------------------------------------
# policy/setpolicies-v07.mjs (fallback denylist) reads this.
POLICY_CLIENT_DENYLIST=
